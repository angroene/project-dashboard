{
  "schemaVersion": 1,
  "id": "watering-log",
  "title": "Watering log",
  "state": "active",
  "schedule": {
    "frequency": "daily",
    "time": "19:00",
    "timezone": "Europe/Lisbon",
    "startDate": "2026-11-10",
    "endDate": "2027-03-31",
    "catchUpDays": 0
  },
  "record": {
    "recordType": "question",
    "title": "Watering log {date}",
    "summary": "Did the beds get watered on {date}?",
    "status": "open",
