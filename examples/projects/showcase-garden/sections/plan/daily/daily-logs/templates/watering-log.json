    "questionRevision": 1,
    "answerSchema": {
      "type": "composite",
      "fields": [
        {
          "id": "watered",
          "label": "Beds watered",
          "type": "approval",
          "default": "approve"
        },
        {
          "id": "notes",
          "label": "Notes",
          "type": "free-text",
          "required": false,
          "minLength": 0,
          "maxLength": 500
        }
      ]
    }
  }
}
