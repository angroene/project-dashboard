{
  "$id": "recurring-template.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "state": {
      "default": "active",
      "type": "string",
      "enum": [
        "active",
        "paused",
        "disabled"
      ]
    },
    "schedule": {
      "type": "object",
      "properties": {
        "frequency": {
          "type": "string",
          "const": "daily"
        },
        "time": {
          "default": "00:00",
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "timezone": {
          "type": "string",
          "maxLength": 64
        },
        "startDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "endDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "catchUpDays": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 31
        }
      },
      "required": [
        "frequency",
        "timezone",
        "startDate"
      ]
    },
    "record": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "title",
    "schedule",
    "record"
  ]
}
