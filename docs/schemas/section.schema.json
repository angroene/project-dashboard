{
  "$id": "section.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "displayType": {
      "type": "string",
      "enum": [
        "main-tab",
        "page-tab",
        "expandable-card"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "default": "",
      "type": "string",
      "maxLength": 300
    },
    "order": {
      "default": 100,
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "icon": {
      "type": "string",
      "enum": [
        "folder",
        "gamepad",
        "map",
        "book",
        "chart",
        "question",
        "bug",
        "review",
        "check",
        "flag",
        "clock",
        "file",
        "image",
        "code",
        "wrench",
        "star",
        "inbox",
        "list",
        "box",
        "bolt"
      ]
    },
    "visible": {
      "default": true,
      "type": "boolean"
    },
    "defaultOpen": {
      "default": false,
      "type": "boolean"
    },
    "views": {
      "default": [],
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "records",
          "progress",
          "activity",
          "attention"
        ]
      }
    },
    "actions": {
      "default": [
        "copy",
        "open-detail"
      ],
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "copy",
          "download",
          "bulk-download",
          "export-xlsx",
          "import-xlsx",
          "respond",
          "upload",
          "mark-read",
          "open-detail",
          "comment"
        ]
      }
    },
    "filters": {
      "default": {
        "sort": "updated-desc"
      },
      "type": "object",
      "properties": {
        "statuses": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          }
        },
        "defaultStatus": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "sort": {
          "default": "updated-desc",
          "type": "string",
          "enum": [
            "updated-desc",
            "updated-asc",
            "priority",
            "title",
            "order"
          ]
        }
      }
    },
    "pageSize": {
      "default": 25,
      "type": "integer",
      "minimum": 5,
      "maximum": 200
    },
    "fields": {
      "default": [],
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9_-]{0,39}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "type": {
            "type": "string",
            "enum": [
              "checkbox",
              "yes-no",
              "choice",
              "text",
              "date"
            ]
          },
          "help": {
            "type": "string",
            "maxLength": 300
          },
          "options": {
            "minItems": 1,
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                }
              },
              "required": [
                "id",
                "label"
              ]
            }
          },
          "editableBy": {
            "default": [
              "user",
              "agent"
            ],
            "minItems": 1,
            "maxItems": 2,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "user",
                "agent"
              ]
            }
          },
          "filter": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "label",
          "type"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "displayType",
    "title"
  ]
}
