{
  "name": "agents-project-dashboard",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Folder-configured, project-independent dashboard for questions, answers, tasks and progress. Works with any producer, human or automated.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:server": "tsx watch src/server/main.ts",
    "dev:web": "vite",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/server/main.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "fixtures": "tsx scripts/gen-fixtures.ts",
    "schemas": "tsx scripts/gen-schemas.ts",
    "perf": "tsx scripts/perf.ts",
    "e2e": "tsx scripts/e2e.ts",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vite build && tsx scripts/e2e.ts",
    "lint": "eslint .",
    "coverage": "vitest run --coverage",
    "demo:agent": "tsx scripts/agent-demo.ts",
    "agent-token": "tsx scripts/agent-token.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/multipart": "10.1.8",
    "@fastify/static": "10.1.11",
    "exceljs": "4.4.0",
    "fastify": "5.12.8",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tanstack/react-query": "5.90.2",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "22.18.12",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "playwright-core": "1.56.1",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-markdown": "10.1.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "overrides": {
    "uuid": "11.1.1",
    "unzipper": "0.12.3",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    }
  }
}
